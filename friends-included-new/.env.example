# Supabase server credentials.
# Vercel Marketplace normally injects SUPABASE_URL + SUPABASE_SECRET_KEY automatically.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Manual fallback names also supported:
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets (server-only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_ID=

# Telegram (server-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Public links shown on the website
NEXT_PUBLIC_TELEGRAM_BOT_URL=
NEXT_PUBLIC_GOOGLE_SHEET_URL=
NEXT_PUBLIC_GITHUB_URL=https://github.com/QAZAQ7/dslastwork
